{
  "name": "finn-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP servers for browsing finn.no, one per marketplace (currently: FINN Jobb)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "finn-jobs-mcp": "dist/jobs/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsc",
    "watch": "tsc --watch",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "register": "node scripts/register.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.128.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
